#=================================================
#  MGR 集群公共环境变量(所有节点完全一致)
#  节点差异化参数(server_id / local_address / bootstrap)在 docker-compose-mgr.yml 中设置
#=================================================
# 时区
TZ=Asia/Shanghai
# 数据库超级用户密码
MYSQL_ROOT_PASSWORD=ysyh!9Sky
# root 允许来源
MYSQL_ROOT_HOST=%
# 业务库名与账号
MYSQL_DATABASE=xiaonuo
MYSQL_USER=xiaonuo
MYSQL_PASSWORD=ysyh!9Sky
# 复制/MGR 分布式恢复账号
MYSQL_REPL_USER=repl
MYSQL_REPL_PASSWORD=ysyh!9Sky
# 组名(UUID, 集群内必须一致)
# 新建集群时建议重新生成: docker run --rm iflyelf/ubuntu:lite bash -c 'cat /proc/sys/kernel/random/uuid'
MYSQL_MGR_GROUP_NAME=d9b5b0c4-8f1e-11f0-9a52-0242ac110002
# 组复制通信地址(所有节点一致, 端口固定 33061)
MYSQL_MGR_GROUP_SEEDS=172.186.1.11:33061,172.186.1.12:33061,172.186.1.13:33061
# 单主模式(ON=一主多从自动选主; OFF=多主)
MYSQL_MGR_SINGLE_PRIMARY=ON

#=================================================
#  自动调优(可选): 默认按容器 CPU/内存自动计算容量类参数
#  MYSQL_MEMORY_LIMIT=8Gi
#  MYSQL_CPU_LIMIT=4
#  MYSQL_IOPS=4000
#  MYSQL_MAX_CONNECTIONS=500
#  MYSQL_AUTO_TUNE=0   # 关闭自动调优
#=================================================
