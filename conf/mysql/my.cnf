#=================================================
#  Percona Server for MySQL 8.4 LTS 生产级配置
#  - 已按 MySQL 8.4 清理全部已移除/已废弃参数
#    （query_cache、innodb_log_files_in_group、innodb_log_file_size、
#      slave_*、sync_master_info、relay_log_recovery、skip-federated、
#      symbolic_links、explicit_defaults_for_timestamp 等）
#  - InnoDB redo 使用 8.4 的 innodb_redo_log_capacity 统一管理
#  - 参数取自已验证的 k8s MGR 集群配置(workspace/k8s/mysql-cluster)，
#    并按单机/容器内存下调了连接数与每会话缓冲区，避免小内存主机 OOM
#  - MGR 相关参数见 conf.d/mgr.cnf，运行时动态配置见 conf.d/zz-mgr-auto.cnf
#=================================================

# ****** MySQL 客户端设置 ******
[client]
port = 3306
socket = /var/run/mysqld/mysqld.sock
default_character_set = utf8mb4

[mysql]
prompt = "\u@mysqldb \R:\m:\s [\d]> "
auto_rehash
default_character_set = utf8mb4

# ****** MySQL 服务端设置 ******
[mysqld]
## ---------------- 基础配置 ----------------
# 运行用户
user = mysql
# 监听地址与端口
bind_address = 0.0.0.0
port = 3306
# 数据/临时/通信文件目录
datadir = /var/lib/mysql
tmpdir = /tmp
socket = /var/run/mysqld/mysqld.sock
pid_file = /var/run/mysqld/mysqld.pid
# 导入导出文件仅允许落在数据目录
secure_file_priv = /var/lib/mysql
# 禁用 DNS 反解(容器内主机名解析不可靠, 且可降低连接延迟)
skip_name_resolve = ON
# 跳过外部锁定
skip_external_locking = ON
# 默认存储引擎 + 禁用不使用的引擎
default_storage_engine = InnoDB
disabled_storage_engines = "MyISAM,BLACKHOLE,FEDERATED,ARCHIVE,MEMORY"
# 字符集(8.0+ 默认 utf8mb4 / utf8mb4_0900_ai_ci; MGR 各成员必须完全一致)
character_set_server = utf8mb4
collation_server = utf8mb4_0900_ai_ci
init_connect = 'SET NAMES utf8mb4'
# 时区(容器的绝对时间与宿主机内核一致, 这里只决定显示时区)
default_time_zone = '+8:00'
# 事务隔离级别
transaction_isolation = READ-COMMITTED
# 事件调度器
event_scheduler = ON
# 表名大小写: 只能在初始化时生效, 且 MGR 各成员必须一致(1=不区分)
lower_case_table_names = 1
# GROUP_CONCAT 结果上限
group_concat_max_len = 1048576

## ---------------- 连接配置 ----------------
# 最大连接数(单机 10000 足够; 可达上限受内存约束, 大并发请上调并同步减小每会话缓冲)
max_connections = 10000
# 客户端连接错误次数上限
max_connect_errors = 1000000
# 连接超时
connect_timeout = 600
# 交互式/非交互式空闲连接超时(默认 8 小时, 与常见连接池回收时间匹配)
interactive_timeout = 28800
wait_timeout = 28800
# 监听队列(实际生效值受内核 somaxconn 限制)
back_log = 4096

## ---------------- 会话内存配置(按需调整) ----------------
# 每会话缓冲区合计约 15MB; max_connections 上调时需评估内存总量
read_buffer_size = 1M
read_rnd_buffer_size = 1M
sort_buffer_size = 4M
join_buffer_size = 8M
# 内部临时表(内存表)上限
tmp_table_size = 256M
max_heap_table_size = 256M
# 单个网络包的硬上限(大字段/大 SQL 需按业务调整)
max_allowed_packet = 1G

## ---------------- 表缓存/线程缓存 ----------------
table_definition_cache = 8192
table_open_cache = 16384
table_open_cache_instances = 16
thread_cache_size = 512
open_files_limit = 65535
# 事务 binlog 缓存(binlog_cache_size 为单事务缓存, 复杂大事务可上调)
binlog_cache_size = 16M
max_binlog_cache_size = 2G

## ---------------- 二进制日志(GTID + MGR 友好) ----------------
log_bin = /var/lib/mysql/mysql-bin
# 说明: 8.4 起 binlog_format 已废弃(仅支持 ROW, 默认即 ROW), 不再显式设置
# MGR 要求行镜像为 FULL, 且 checksum 为 NONE
binlog_row_image = FULL
binlog_checksum = NONE
# 每次提交刷盘, 保证崩溃场景下 binlog 不丢
sync_binlog = 1
max_binlog_size = 1G
# binlog 保留 7 天(优先使用秒级参数, binlog_expire_logs_days 已废弃)
binlog_expire_logs_seconds = 604800
# 记录 ROW 事件对应的原始 SQL, 便于审计/排查
binlog_rows_query_log_events = ON
# 允许在 binlog 开启时创建函数/触发器
log_bin_trust_function_creators = ON
# GTID(主从复制与 MGR 的基础)
gtid_mode = ON
enforce_gtid_consistency = ON

## ---------------- 副本/并行复制 ----------------
# 说明: replica_parallel_type 已在 8.0.27 后仅支持 LOGICAL_CLOCK(默认值), 不再显式设置
replica_parallel_workers = 8
replica_preserve_commit_order = ON

## ---------------- 日志配置 ----------------
log_error = /var/lib/mysql/error.log
log_timestamps = SYSTEM
log_error_verbosity = 2
# 慢查询
slow_query_log = ON
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 1
log_queries_not_using_indexes = ON
log_throttle_queries_not_using_indexes = 60
log_slow_admin_statements = ON
log_slow_replica_statements = ON
log_slow_extra = ON
min_examined_row_limit = 100

## ---------------- InnoDB 配置 ----------------
innodb_file_per_table = ON
innodb_data_file_path = ibdata1:12M:autoextend
# 缓冲池: 建议为容器内存的 50%~75%, 单实例 2G 为保守默认值
innodb_buffer_pool_size = 2G
innodb_buffer_pool_instances = 2
innodb_buffer_pool_load_at_startup = ON
innodb_buffer_pool_dump_at_shutdown = ON
innodb_buffer_pool_dump_pct = 25
# 1 = 每次提交刷 redo(最安全); 追求吞吐可改 2(最多丢 1 秒事务)
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT
innodb_flush_neighbors = 0
# 8.4 使用 redo 容量统一管理(替代已移除的 innodb_log_files_in_group/innodb_log_file_size)
innodb_redo_log_capacity = 4G
innodb_log_buffer_size = 128M
# IO 能力(SSD/NVMe 建议 4000 起, 云盘按实际 IOPS 调整)
innodb_io_capacity = 4000
innodb_io_capacity_max = 8000
innodb_lru_scan_depth = 4000
innodb_max_dirty_pages_pct = 90
# 锁等待
innodb_lock_wait_timeout = 300
innodb_rollback_on_timeout = ON
# 线程
innodb_read_io_threads = 8
innodb_write_io_threads = 8
innodb_purge_threads = 4
innodb_thread_concurrency = 0
# 诊断
innodb_print_all_deadlocks = ON
innodb_print_ddl_logs = ON
innodb_status_output_locks = ON
# 严格模式与统计
innodb_strict_mode = ON
innodb_stats_persistent_sample_pages = 64
innodb_autoinc_lock_mode = 2
innodb_online_alter_log_max_size = 4G
innodb_open_files = 65535
innodb_sort_buffer_size = 67108864
# 临时表空间
innodb_temp_data_file_path = ibtmp1:12M:autoextend:max:2G
# undo 空间自动收缩
innodb_undo_log_truncate = ON
innodb_max_undo_log_size = 1G
# NUMA: 容器默认没有 SYS_NICE 权限, 开启会产生大量 mbind 告警, 故默认关闭;
#      物理 NUMA 主机且容器具备 --cap-add SYS_NICE 时可用启动参数覆盖为 ON
innodb_numa_interleave = OFF

## ---------------- Performance Schema ----------------
performance_schema = ON
# 仅开启 MDL 等待采集(全量 memory 统计开销较大, 需要时再单独打开)
performance_schema_instrument = 'wait/lock/metadata/sql/mdl=ON'

# ****** 备份/导出 ******
[mysqldump]
quick
max_allowed_packet = 1G

# ****** 配置文件包含目录(MGR / 运行时生成的配置放这里) ******
!includedir /etc/mysql/conf.d/
